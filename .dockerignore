# Dependencies (largest files - npm/composer will rebuild these)
node_modules/
vendor/

# Storage directories (can be huge - not needed in image)
storage/app/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
# Note: bootstrap/cache is needed by Laravel and will be regenerated during build

# Docker storage (database, logs, etc - HUGE 5GB directory)
.docker/storage/

# Dev TLS certs generated per developer by .docker/scripts/generate-dev-certs.sh
# (#425). Mirrors .gitignore: without this, `COPY . .` bakes each developer's
# private key into an image layer. The dev stack bind-mounts them at runtime.
.docker/**/*.key
.docker/**/*.crt
.docker/**/*.csr

# Development files (exclude local development env files)
.env
# Note: .env.local is needed by Dockerfile for production builds
.env.*.local

# Version control
.git/
.gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Documentation (not needed in image)
README.md
docs/

# CI/CD
.github/

# Local development TLS material. These are self-signed dev certificates whose
# PRIVATE KEYS are committed; docker-compose.yml and .docker/docker-compose.full.yml
# bind-mount them from the host, so nothing needs them inside an image.
.docker/admin/
.docker/api/
.docker/cert/

# Release tooling (shell scripts run on the CI runner, never in the container)
build/
makefile

# Note: .prettierrc.json, .prettierignore, changelog.d/ and CHANGELOG.md are
# deliberately NOT excluded. CI runs `npm test` inside the dev image, whose
# pretest hook is `prettier --check .` -- it reads its config and ignore list
# from the image, and excluding them would both break the check (prettier would
# descend into vendor/ and node_modules/) and silently drop files from its scope.
