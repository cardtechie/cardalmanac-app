# ---------------------------------------------------------------------------
# .env.local -- TRACKED ON PURPOSE. READ BEFORE EDITING.
#
# This file is committed so that `make up`, the Docker image build, and GitHub
# Actions all work from a clean clone with zero per-developer setup. It is
# published with the repository, so it may hold REPOSITORY DEFAULTS ONLY:
# local hostnames, container names, debug switches, and the local-only MySQL
# literal `password`.
#
# NEVER put a real key, secret, token, or credential here. The Dockerfile
# copies this file to `.env` inside the image, so anything added here ships in
# every published image as well as in the repository. APP_KEY stays blank (see
# docs/LOCAL-ENVIRONMENTS.md#application-keys). Supply real values through
# your untracked root `.env`, which the `make` targets and the compose
# `${VAR}` substitutions read instead.
#
# Enforced in CI by the `env-local-credential-assignment` rule in
# .gitleaks.toml. Rule set by the operator on cardtechie/cardalmanac-app#463.
# ---------------------------------------------------------------------------

APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=https://cardalmanac.dev:8541
LOG_CHANNEL=errorlog

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=cardadmin
DB_USERNAME=root
DB_PASSWORD=password

TRADINGCARDAPI_URL=https://tcapi
TRADINGCARDAPI_SSL_VERIFY=false

MIX_APP_URL=https://cardalmanac.dev:8541
