# --- App (REQUIRED) ---------------------------------------------------------
APP_NAME=CardAlmanac
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://cardalmanac.dev:8541

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (REQUIRED) ------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# --- Drivers -------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# --- Trading Card API (REQUIRED) ----------------------------------------------
# Without these, the app has no card data and API authentication fails outright.
TRADINGCARDAPI_URL=
TRADINGCARDAPI_CLIENT_ID=
TRADINGCARDAPI_CLIENT_SECRET=
# Only for a local instance of the API using a self-signed certificate. Leave
# true (or unset) against any real API -- turning it off hides a genuine trust
# failure.
TRADINGCARDAPI_SSL_VERIFY=true

# --- Frontend build (REQUIRED) --------------------------------------------------
# Inlined into the public JS bundle at BUILD time by Laravel Mix, not read at
# runtime. A missing value breaks nav links silently (they render as
# "undefined/app", "undefined/about", etc. with nothing in the logs).
MIX_APP_URL=https://cardalmanac.dev:8541

# --- Mail ------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional: only used when MAIL_MAILER=mailgun.
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# --- Newsletter (optional) --------------------------------------------------------
# Brevo (formerly Sendinblue) newsletter double opt-in.
# Must never be MIX_-prefixed: Laravel Mix inlines every MIX_* variable into
# the public JS bundle, which would publish this key to every visitor (#426).
BREVO_API_KEY=

# --- Product CTAs (optional) --------------------------------------------------------
PRODUCT_CTA_API_ENABLED=false
PRODUCT_CTA_API_URL=
